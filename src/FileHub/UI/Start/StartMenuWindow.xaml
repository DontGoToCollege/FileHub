<Window x:Class="FileHub.UI.Start.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start" Width="640" Height="700"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UIFont}" FontSize="13" Foreground="{DynamicResource TextBrush}" ShowActivated="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource StartMenuBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- search -->
            <Grid Margin="28,24,28,8">
                <TextBox x:Name="SearchBox" FontSize="14" MinHeight="40" Padding="40,6,12,6" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="Hint" Text="Search apps, files, folders and contents" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False" FontSize="14"/>
            </Grid>

            <!-- body -->
            <Grid Grid.Row="1" Margin="28,8,28,8">
                <!-- pinned + folders -->
                <ScrollViewer x:Name="PinnedView" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Pinned" FontWeight="SemiBold" Margin="4,4,0,8"/>
                        <ItemsControl x:Name="PinnedItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CommandButton}" Width="96" Height="84" Padding="4" Click="Pinned_Click" Tag="{Binding}" ToolTip="{Binding Path}">
                                        <StackPanel>
                                            <Grid Width="32" Height="32" Margin="0,4,0,6">
                                                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding Glyph, Converter={StaticResource NullToVisInv}}"/>
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="26" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Glyph, Converter={StaticResource NullToVis}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="34" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Folders" FontWeight="SemiBold" Margin="4,16,0,8"/>
                        <ItemsControl x:Name="FolderItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CommandButton}" Height="40" Padding="10,0" Margin="0,0,6,6" Click="Pinned_Click" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" Visibility="{Binding Glyph, Converter={StaticResource NullToVisInv}}"/>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Glyph, Converter={StaticResource NullToVis}}"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- results -->
                <Grid x:Name="ResultsView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ResultsHeader" Text="Best matches" FontWeight="SemiBold" Margin="4,4,0,8"/>
                    <ListBox x:Name="ResultsList" Grid.Row="1" MouseDoubleClick="Results_DoubleClick" KeyDown="Results_KeyDown" MouseRightButtonUp="Results_RightClick" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="8,6" Margin="0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" x:Name="MoreBtn" Content="See more results in File Hub  ›" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="More_Click"/>
                </Grid>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="2" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="0,0,8,8" Padding="28,10">
                <Grid>
                    <Button Style="{StaticResource CommandButton}" Click="User_Click" HorizontalAlignment="Left" Padding="6,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"><TextBlock x:Name="UserInitial" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock x:Name="UserNameText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" x:Name="PowerPanel">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7E8;" ToolTip="Power" Click="Power_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
