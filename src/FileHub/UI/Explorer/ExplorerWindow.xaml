<Window x:Class="FileHub.UI.Explorer.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileHub" Width="1180" Height="760" MinWidth="640" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UIFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- tab strip -->
        <Border Background="{DynamicResource TabBackgroundBrush}" Padding="8,6,8,0">
            <DockPanel LastChildFill="False">
                <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="bd" CornerRadius="6,6,0,0" MinWidth="140" MaxWidth="240" Margin="0,0,2,0" Padding="10,6" Background="Transparent" MouseLeftButtonDown="Tab_MouseDown" MouseDown="Tab_MiddleClick" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="10" Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close tab (Ctrl+W)"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/></DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=bd}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE710;" Width="30" Height="30" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False"/>
    </Grid>
</Window>
