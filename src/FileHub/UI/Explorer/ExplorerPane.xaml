<UserControl x:Class="FileHub.UI.Explorer.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileHub.UI.Controls"
             xmlns:explorer="clr-namespace:FileHub.UI.Explorer"
             Focusable="False">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== toolbar: nav buttons, address, search -->
        <Grid Margin="8,6,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
                <Button x:Name="FwdBtn" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="Forward_Click"/>
                <Button x:Name="UpBtn" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Up (Alt+Up)" Click="Up_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="Refresh_Click"/>
            </StackPanel>

            <Border Grid.Column="1" x:Name="AddressBorder" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,8,0" MouseLeftButtonDown="Address_MouseDown" Cursor="IBeam">
                <Grid>
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Cursor="Arrow" VerticalAlignment="Center">
                        <ItemsControl x:Name="Crumbs" Margin="4,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CommandButton}" Content="{Binding Name}" Tag="{Binding Path}" Click="Crumb_Click" Height="26" Padding="6,0"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,0" Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="AddressBox" Visibility="Collapsed" BorderThickness="0" Background="Transparent" KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostFocus" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" Padding="30,5,28,5" ToolTip="Search this folder using the index. Syntax: ext:jpg size:>1mb dm:thisweek content:text regex:… (F1 for help)"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Search" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                <Button x:Name="ClearSearchBtn" Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="11" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed" Click="ClearSearch_Click"/>
            </Grid>
        </Grid>

        <!-- ===================== command bar -->
        <Border Grid.Row="1" Padding="8,0,8,4">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CommandButton}" Click="New_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="New"/><TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0"/></StackPanel></Button>
                    <Rectangle Width="1" Fill="{DynamicResource DividerBrush}" Margin="6,8"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Cut (Ctrl+X)" Click="Cmd_Click" Tag="cut"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy (Ctrl+C)" Click="Cmd_Click" Tag="copy"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="Paste (Ctrl+V)" Click="Cmd_Click" Tag="paste"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename (F2)" Click="Cmd_Click" Tag="rename"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete (Del)" Click="Cmd_Click" Tag="delete"/>
                    <Rectangle Width="1" Fill="{DynamicResource DividerBrush}" Margin="6,8"/>
                    <Button Style="{StaticResource CommandButton}" Click="Sort_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="Sort"/><TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0"/></StackPanel></Button>
                    <Button Style="{StaticResource CommandButton}" Click="View_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="View"/><TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0"/></StackPanel></Button>
                    <Rectangle Width="1" Fill="{DynamicResource DividerBrush}" Margin="6,8"/>
                    <Button Style="{StaticResource CommandButton}" Click="Cmd_Click" Tag="openterminal" ToolTip="Open in Terminal"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="Terminal"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="NavToggle" Style="{StaticResource IconToggle}" Content="&#xE8A0;" ToolTip="Navigation pane" IsChecked="True" Click="NavToggle_Click"/>
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource IconToggle}" Content="&#xE8A1;" ToolTip="Preview pane (Alt+P)" Click="PreviewToggle_Click"/>
                    <Button Style="{StaticResource CommandButton}" Click="Hub_Click" ToolTip="Open File Hub (search everything)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE773;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="Hub"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== content: nav | list | preview -->
        <Grid Grid.Row="2" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="220" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="PreviewCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="NavTree" SelectedItemChanged="NavTree_SelectedItemChanged" MouseRightButtonUp="NavTree_MouseRightButtonUp" AllowDrop="True" DragOver="NavTree_DragOver" Drop="NavTree_Drop" Margin="0,4,0,0">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type explorer:NavNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Height="24">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Width="20" Margin="0,0,6,0" Visibility="{Binding Glyph, Converter={StaticResource NullToVis}}" Foreground="{DynamicResource AccentBrush}"/>
                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" Visibility="{Binding Glyph, Converter={StaticResource NullToVisInv}}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" ClipToBounds="True">
                <Grid>
                    <controls:FileListControl x:Name="FileList"/>
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" VerticalAlignment="Top" Height="3" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <controls:PreviewPane x:Name="Preview" Grid.Column="3" Visibility="Collapsed"/>
        </Grid>

        <!-- ===================== status bar -->
        <Border Grid.Row="3" Padding="12,4" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SelectionText" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="IndexStatusText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
