<UserControl x:Class="FileHub.UI.Hub.StartMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Start menu" Style="{StaticResource Title}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Windows integration" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ReplaceWin" Content="Open FileHub's start menu when the Windows key is tapped (replaces the Windows Start menu)"/>
                    <CheckBox x:Name="ReplaceWinE" Content="Open FileHub Explorer with Win+E (instead of Windows File Explorer)"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,2,0,8" Text="Win+other key shortcuts keep working. Ctrl+Esc still opens the Windows Start menu. Changes apply when you leave this page."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Position" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PositionCombo" Width="160"><ComboBoxItem Content="Left (classic)" Tag="Left"/><ComboBoxItem Content="Centered (Windows 11)" Tag="Center"/></ComboBox>
                        <TextBlock Text="Quick results" VerticalAlignment="Center" Margin="24,0,8,0"/>
                        <TextBox x:Name="MaxResultsBox" Width="50" MinHeight="26" Padding="4,2"/>
                    </StackPanel>
                    <CheckBox x:Name="SearchContent" Content="Also search file contents in the start menu (slower)" Margin="0,8,0,0"/>
                    <CheckBox x:Name="PowerButtons" Content="Show power buttons (lock, sleep, restart, shut down, sign out)"/>
                    <CheckBox x:Name="UserName" Content="Show user name"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Preview start menu now" Click="Preview_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Windows folders to show" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="FolderChecks"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pinned shortcuts" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Path can be a program, file, folder, URL, ms-settings: link, or ::Hub / ::Explorer for FileHub windows." Margin="0,0,0,8"/>
                    <DataGrid x:Name="Grid" MinHeight="140" MaxHeight="360" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="Path / command" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" Click="Add_Click"/>
                        <Button Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
                        <Button Content="Remove" Click="Remove_Click" Margin="8,0,0,0"/>
                        <Button Content="Move up" Click="Up_Click" Margin="8,0,0,0"/>
                        <Button Content="Move down" Click="Down_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
