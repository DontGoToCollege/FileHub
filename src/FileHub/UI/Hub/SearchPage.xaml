<UserControl x:Class="FileHub.UI.Hub.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileHub.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- search box + options -->
        <Grid Margin="16,14,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" FontSize="16" MinHeight="42" Padding="40,6,36,6" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="Hint" Text="Search everything…  e.g.  report ext:docx dm:thismonth   |   *.mp4 size:>1gb   |   content:invoice" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ClearBtn" Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" Click="Clear_Click"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <ToggleButton x:Name="RegexToggle" Content=".*" ToolTip="Regular expressions" Width="40" Click="Option_Click" FontFamily="Consolas" FontWeight="Bold"/>
                <ToggleButton x:Name="CaseToggle" Content="Aa" ToolTip="Match case" Width="40" Margin="4,0,0,0" Click="Option_Click"/>
                <ToggleButton x:Name="WordToggle" Content="W" ToolTip="Whole word" Width="40" Margin="4,0,0,0" Click="Option_Click"/>
                <ToggleButton x:Name="PathToggle" Content="\" ToolTip="Match full path" Width="40" Margin="4,0,0,0" Click="Option_Click"/>
            </StackPanel>
        </Grid>

        <!-- filter chips + view controls -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <StackPanel Orientation="Horizontal" x:Name="Chips">
                <ToggleButton Style="{StaticResource Chip}" Content="All" Tag="" IsChecked="True" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Folders" Tag="folder" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Pictures" Tag="picture" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Videos" Tag="video" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Audio" Tag="audio" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Documents" Tag="document" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Code" Tag="code" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Archives" Tag="archive" Click="Chip_Click"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Apps" Tag="executable" Click="Chip_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Sort" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SortCombo" Width="120" SelectionChanged="Sort_Changed" MinHeight="28">
                    <ComboBoxItem Content="Relevance" Tag="None"/>
                    <ComboBoxItem Content="Name" Tag="Name"/>
                    <ComboBoxItem Content="Path" Tag="Path"/>
                    <ComboBoxItem Content="Size" Tag="Size"/>
                    <ComboBoxItem Content="Date modified" Tag="Modified"/>
                    <ComboBoxItem Content="Date created" Tag="Created"/>
                    <ComboBoxItem Content="Extension" Tag="Extension"/>
                    <ComboBoxItem Content="Type" Tag="Type"/>
                </ComboBox>
                <ToggleButton x:Name="DescToggle" Style="{StaticResource IconToggle}" Content="&#xE74B;" ToolTip="Descending" Click="Sort_Changed" Margin="2,0,10,0"/>
                <ToggleButton x:Name="ViewDetails" Style="{StaticResource IconToggle}" Content="&#xE8A9;" ToolTip="Details" Tag="Details" IsChecked="True" Click="View_Click"/>
                <ToggleButton x:Name="ViewMedium" Style="{StaticResource IconToggle}" Content="&#xE80A;" ToolTip="Medium icons" Tag="MediumIcons" Click="View_Click"/>
                <ToggleButton x:Name="ViewLarge" Style="{StaticResource IconToggle}" Content="&#xE8B9;" ToolTip="Large thumbnails" Tag="LargeIcons" Click="View_Click"/>
                <ToggleButton x:Name="ViewXL" Style="{StaticResource IconToggle}" Content="&#xE91B;" ToolTip="Extra large thumbnails" Tag="ExtraLargeIcons" Click="View_Click"/>
                <ToggleButton x:Name="PreviewToggle" Style="{StaticResource IconToggle}" Content="&#xE8A1;" ToolTip="Preview pane" Click="Preview_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- results -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewCol" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" ClipToBounds="True">
                <Grid>
                    <controls:FileListControl x:Name="Results"/>
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" VerticalAlignment="Top" Height="3" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <controls:PreviewPane x:Name="Preview" Grid.Column="1" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="3" Padding="16,6">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="SelText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
