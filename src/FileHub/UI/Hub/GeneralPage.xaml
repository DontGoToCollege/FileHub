<UserControl x:Class="FileHub.UI.Hub.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Title}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ThemeCombo" Width="160"><ComboBoxItem Content="Follow Windows" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Startup &amp; background" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StartWithWindows" Content="Start FileHub with Windows (in the background, so the index and Win key are ready)"/>
                    <CheckBox x:Name="KeepRunning" Content="Keep running in the background when all windows are closed"/>
                    <CheckBox x:Name="TrayIcon" Content="Show tray icon"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Global hotkey for the Hub" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="HotkeyBox" Width="180" ToolTip="e.g. Ctrl+Alt+Space, Ctrl+Shift+F, Win+Space"/>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Search defaults" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Maximum results shown" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="MaxResultsBox" Width="80" MinHeight="26" Padding="4,2"/>
                        <TextBlock Text="(higher = more memory/time for huge result sets)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="VersionText"/>
                    <TextBlock x:Name="DataText" Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open data folder" Click="OpenData_Click"/>
                        <Button Content="Open log folder" Click="OpenLogs_Click" Margin="8,0,0,0"/>
                        <Button Content="Exit FileHub completely" Click="Exit_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
