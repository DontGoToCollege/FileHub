<UserControl x:Class="FileHub.UI.Hub.FileTypesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="File types &amp; open-with" Style="{StaticResource Title}"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                       Text="Every extension found in the index, with counts. Set a FileHub 'Open with' program to override what happens when you open that type from FileHub (Windows defaults are untouched). Double-click a row to search that type."/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox x:Name="FilterBox" Width="220" TextChanged="Filter_Changed" ToolTip="Filter extensions"/>
                <Button Content="Refresh counts" Click="Refresh_Click" Margin="8,0,0,0"/>
                <Button Content="Browse program for selected…" Click="Browse_Click" Margin="8,0,0,0"/>
                <Button Content="Clear override" Click="Clear_Click" Margin="8,0,0,0"/>
                <Button Content="Windows default apps…" Click="WinDefaults_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="Grid" SelectionMode="Single" MouseDoubleClick="Grid_DoubleClick" IsReadOnly="False" VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Files" Binding="{Binding Count, StringFormat=N0}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Total size" Binding="{Binding SizeText}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="FileHub 'Open with' program" Binding="{Binding OpenWith, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
